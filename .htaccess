# .htaccess for inodesain.com/agro
# Agrobusiness ERP System - Production Configuration

# Force PHP execution for .php files (LiteSpeed / cPanel)
<IfModule mime_module>
    AddHandler application/x-httpd-php .php
</IfModule>

# Enable Rewrite Engine
RewriteEngine On
RewriteBase /agro/

# Force HTTPS (Recommended for production)
# Uncomment the following lines if you have SSL certificate
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect www to non-www (or vice versa)
# Uncomment if needed:
# RewriteCond %{HTTP_HOST} ^www\.inodesain\.com$ [NC]
# RewriteCond %{REQUEST_URI} ^/agro/
# RewriteRule ^(.*)$ https://inodesain.com/agro/$1 [L,R=301]

# Handle front controller (if file/directory doesn't exist, route to index.php)
# DISABLED - Not needed for this application
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

# Security Settings
# Disable directory browsing
Options -Indexes

# Prevent access to sensitive files
<FilesMatch "\.(sql|md|bak|log|ini|sh|bat|txt)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect config directory
<IfModule mod_rewrite.c>
    RewriteRule ^config/ - [F,L]
</IfModule>

# Protect database directory
<IfModule mod_rewrite.c>
    RewriteRule ^database/ - [F,L]
</IfModule>

# Prevent access to hidden files (like .git, .env, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# PHP Settings — wrapped in all known mod_php variants to avoid 500 on LiteSpeed
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
    php_value auto_prepend_file none
    php_value auto_append_file none
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
    php_value auto_prepend_file none
    php_value auto_append_file none
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
    php_value auto_prepend_file none
    php_value auto_append_file none
</IfModule>

# Compression for better performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/x-javascript "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresDefault "access plus 2 days"
</IfModule>

# Prevent hotlinking (optional)
# RewriteCond %{HTTP_REFERER} !^$
# RewriteCond %{HTTP_REFERER} !^https?://(www\.)?inodesain\.com [NC]
# RewriteRule \.(jpg|jpeg|png|gif|svg)$ - [F,NC]

# Custom Error Pages (create these files if needed)
# ErrorDocument 404 /agro/404.php
# ErrorDocument 500 /agro/500.php
# ErrorDocument 403 /agro/403.php

# Set default charset
AddDefaultCharset UTF-8

# Prevent clickjacking
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>